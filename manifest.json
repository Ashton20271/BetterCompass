{
  "manifest_version": 3,
  "name": "Better Compass",
  "description": "Some quality of life improvements for Compass",
  "version": "1.3.2",
    "icons": {
    "128": "icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.compass.education/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css",
        "never-invert.css"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Better Compass"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ]
}
